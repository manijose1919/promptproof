{
  "name": "promptproof",
  "version": "1.0.0",
  "description": "Jest for prompts — a free, offline regression-testing harness for LLM features, with console/junit/github reporters and a GitHub Action.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "promptproof": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "HOW-TO.md", "SETUP.md", "SECURITY.md", "CHANGELOG.md", "LICENSE", "action.yml", "examples"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run"
  },
  "keywords": ["llm", "prompt", "testing", "eval", "regression", "ai", "ci"],
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  }
}
